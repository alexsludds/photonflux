# Local Python venv (706 MB, Mac-native) — never push to the Space
.venv-circulax/

# Generated plots / scratch
out/

# Mac-native binaries — the image rebuilds openvaf-ir for Linux from source
bin/openvaf-r
bin/openvaf-ir

# Mac-native compiled device models — regenerated for Linux at image warmup
models/*.osdi
models/__jax__/*.osdi

# Local/user runtime state
webapp/uploads/
webapp/models_user/

# Python / editor / OS noise
**/__pycache__/
*.pyc
*.pyo
.DS_Store
.vscode/
.idea/
*.swp

# Python build artifact
*.egg-info/
