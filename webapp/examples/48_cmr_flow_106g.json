    "probes": [
      {
        "name": "thru",
        "at": "DC2,p3",
        "color": "#6ecbf5"
      },
      {
        "name": "drive",
        "at": "PN_A,cat",
        "color": "#4ade80"
      },
      {
        "name": "ring",
        "at": "WG_R1,p1",
        "color": "#e6862c",
        "hide": true
      },
      {
        "name": "mod_in",
        "at": "LAS,p1"
      }
    ],
    "globals": {
      "baud": 106250000000.0
    }
  },
  "analysis": {
    "mode": "transient",
    "t_stop": 9.411764705882354e-09,
    "points": 10000,
    "link": {
      "probe": "thru",
      "ffe_taps": 0,
      "dfe_taps": 0
    }
  },
  "flow": {
    "name": "Resonance → PAM4 eye → optimize → evaluate",
    "vars": {
      "detune_pm": 2.5,
      "dL_nm": 240.19,
      "vbias": 2.0,
      "vswing": 3.0
    },
    "set": {
      "WG_A.length_m": "2.0120095e-05 + dL_nm*0.5e-9",
      "WG_B.length_m": "2.0120095e-05 - dL_nm*0.5e-9",
      "PRBS.v0": "vbias - vswing/2",
      "PRBS.v1": "vbias + vswing/2"
    },
    "stateye": {
      "rx_bw": "auto",
      "rx_order": 4,
      "taps": 5,
      "pre": 1,
      "dfe": 0,
      "method": "mmse",
      "limits": true,
      "use_pattern": true,
      "s_noise": 0.005,
      "ser": 0.00048,
      "nx": 256,
      "ny": 1024
    },
    "steps": [
      {
        "id": "res",
        "kind": "analysis",
        "title": "Find resonance at the bias",
        "set": {
          "PRBS.v0": "vbias",
          "PRBS.v1": "vbias"
        },
        "analysis": {
          "mode": "dcsweep",
          "instance": "*",
          "param": "wavelength_nm",
          "start": 1309.9,
          "stop": 1310.15,
          "points": 1001
        },
        "outputs": {
          "lam_res": "xat_min(thru)",
          "notch_db": "dbp(min(thru)/max(thru))"
        },
        "checks": [
          "notch_db < -3"
        ]
      },
      {
        "id": "eye",
        "kind": "analysis",
        "title": "PAM4 eye at the lock point",
        "set": {
          "*.wavelength_nm": "lam_res - detune_pm*1e-3"
        },
        "analysis": {
          "mode": "transient",
          "t_stop": 9.411764705882354e-09,
          "points": 10000
        },
        "outputs": {
          "rlm": "rlm(thru)",
          "er_db": "er_db(thru)",
          "rel_oma_db": "rel_oma_db(thru, mod_in)",
          "il_db": "il_db(thru, mod_in)",
          "tdecq_db": "tdecq(thru)"
        },
        "checks": []
      },
      {
        "id": "opt",
        "kind": "optimize",
        "title": "Maximize relOMA within spec",
        "inner": [
          "res",
          "eye"
        ],
        "params": [
          {
            "var": "detune_pm",
            "min": 1.0,
            "max": 6.0
          },
          {
            "var": "vbias",
            "min": 1.6,
            "max": 2.6
          }
        ],
        "objective": "rel_oma_db",
        "maximize": true,
        "constraints": [
          "rlm >= 0.96",
          "tdecq_db <= 1.3",
          "er_db >= 4"
        ],
        "iters": 30
      },
      {
        "id": "eval",
        "kind": "evaluate",
        "title": "Evaluate the best design",
        "inner": [
          "res",
          "eye"
        ],
        "record": "full_period",
        "probes": {
          "in": "mod_in",
          "out": "thru"
        },
        "fom": {
          "rel_oma_db": ">= -2",
          "oma_dbm": null,
          "il_db": null,
          "er_db": ">= 3.5",
          "tdecq_db": "<= 1.5",
          "rlm": ">= 0.95"
        }
      }
    ]
  }
}
