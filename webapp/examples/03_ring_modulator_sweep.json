{
  "title": "Microring modulator tuning",
  "group": "Lasers & modulators",
  "description": "Microring through-port transmission vs wavelength, overlaid at several tuning voltages",
  "schematic": {
    "notes": [
      {
        "x": 40,
        "y": -188,
        "title": "Microring modulator tuning — what this testbench does",
        "lines": [
          "Laser LAS1 feeds the microring RING1; the through port",
          "(prx) ends at TERM1. The analysis sweeps the ring's",
          "operating wavelength across its resonance, so prx traces",
          "the classic Lorentzian notch (deep on resonance, unity",
          "off it).",
          "",
          "The sweep is overlaid at five tuning voltages VT1.V =",
          "-3/-1.5/0/1.5/3 V. Each volt shifts the resonance by",
          "dl_dv_pm = 45 pm/V (electro-optic / carrier effect), so",
          "the notch marches +/-135 pm about 1310 nm (~270 pm end",
          "to end) -- the DC tuning map, read off directly in nm.",
          "",
          "Set RING1.kappa2 = 0.076 (~ critical coupling) and re-run",
          "to see each notch bottom out at a near-perfect null."
        ]
      }
    ],
    "instances": {
      "LAS1": {
        "type": "cw_laser",
        "x": 40,
        "y": 180,
        "rot": 0,
        "settings": {
          "wavelength_nm": 1310.0,
          "power": 0.001
        }
      },
      "RING1": {
        "type": "ring_mod",
        "x": 260,
        "y": 130,
        "rot": 0,
        "settings": {
          "lambda_nm": 1310.0,
          "lambda_res_nm": 1310.0,
          "kappa2": 0.1,
          "dl_dv_pm": 45.0
        }
      },
      "TERM1": {
        "type": "opt_term",
        "x": 460,
        "y": 180,
        "rot": 0,
        "settings": {}
      },
      "VT1": {
        "type": "vdc",
        "x": 280,
        "y": 10,
        "rot": 180,
        "settings": {
          "V": 0.0
        }
      },
      "GND1": {
        "type": "ground",
        "x": 60,
        "y": 264,
        "rot": 0,
        "settings": {}
      },
      "GND2": {
        "type": "ground",
        "x": 290,
        "y": 86,
        "rot": 0,
        "settings": {}
      }
    },
    "wires": [
      {
        "from": "LAS1,p1",
        "to": "RING1,pin"
      },
      {
        "from": "RING1,pout",
        "to": "TERM1,p1"
      },
      {
        "from": "LAS1,p2",
        "to": "GND1,p1"
      },
      {
        "from": "VT1,p1",
        "to": "RING1,vp"
      },
      {
        "from": "VT1,p2",
        "to": "GND2,p1"
      },
      {
        "from": "RING1,vn",
        "to": "GND2,p1"
      },
      {
        "from": "RING1,gnd",
        "to": "GND2,p1"
      }
    ],
    "probes": [
      {
        "name": "prx",
        "at": "RING1,pout",
        "color": "#fbbf24"
      }
    ]
  },
  "analysis": {
    "mode": "dcsweep",
    "instance": "RING1",
    "param": "lambda_nm",
    "start": 1309.5,
    "stop": 1310.5,
    "points": 801,
    "step_instance": "VT1",
    "step_param": "V",
    "step_values": [
      -3,
      -1.5,
      0,
      1.5,
      3
    ],
    "overlay": {
      "color_mode": "distinct"
    }
  }
}
