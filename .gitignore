# Local Python venv (706 MB, Mac-native) — never push to the Space
.venv-circulax/

# Generated plots / scratch
out/

# Mac-native binary — the image rebuilds openvaf-ir for Linux from source
bin/openvaf-ir

# Compiled device models + content-hash JAX cache — regenerated on first use
# (cx.va / warmup.py); never source, always derived.
models/*.osdi
models/*.osdi.meta.json
models/__jax__/

# Local/user runtime state
webapp/uploads/
webapp/models_user/

# Python / editor / OS noise
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store
.vscode/
.idea/
*.swp

# Python build artifact
*.egg-info/

# Local Claude Code settings (per-machine, not shared)
.claude/settings.local.json

# Auto Claude data directory
.auto-claude/
