diff --git a/tests/test_equalization.py b/tests/test_equalization.py
new file mode 100644
index 0000000..0faea8b
--- /dev/null
+++ b/tests/test_equalization.py
@@ -0,0 +1,163 @@
+import numpy as np
+import pytest
+
+from stateye.equalization import apply_ffe, ffe_mmse, noise_enhancement
+
+
+def _isi_pam4(n=4000, sps=16, post=0.35, seed=0):
+    rng = np.random.default_rng(seed)
+    sym = rng.integers(0, 4, n)
+    lv = sym / 3.0
+    # one post-cursor of ISI at the symbol rate, then hold each symbol
+    isi = lv + post * np.concatenate([[0.0], lv[:-1]])
+    return np.repeat(isi, sps), sym, sps
+
+
+def test_taps_sum_to_one_and_ceq():
+    assert noise_enhancement([1.0]) == 1.0
+    assert noise_enhancement([-0.1, 1.2, -0.1]) == pytest.approx(np.sqrt(1.46))
+    w, _, sps = _isi_pam4()
+    taps, info = ffe_mmse(w, sps, n_taps=5, symbols=_isi_pam4()[1])
+    assert np.isclose(np.sum(taps), 1.0)
+    assert taps[2] < 0          # the post-cursor tap cancels the ISI
+    assert info["ceq"] == noise_enhancement(taps) > 1.0
+
+
+@pytest.mark.parametrize("known,post", [(True, 0.35), (False, 0.08)])
+def test_ffe_cancels_a_post_cursor(known, post):
+    """Known pattern: exact even when the raw eye is closed (post 0.35 >
+    level spacing 1/3). Blind: only while the raw eye is still open."""
+    w, sym, sps = _isi_pam4(post=post)
+    taps, info = ffe_mmse(w, sps, n_taps=5, n_pre=1,
+                          symbols=sym if known else None)
+    assert info["rms_error_after"] < 0.1 * info["rms_error_before"]
+    eq = apply_ffe(w, taps, sps, n_pre=info["n_pre"])
+    s = eq[int(sps // 2)::sps][20:-20]
+    d = sym[20:-20]
+    # equalized levels separate cleanly: max of each level < min of the next
+    for k in range(3):
+        assert s[d == k].max() < s[d == k + 1].min()
+
+
+def test_align_linear_window_and_inversion():
+    """A long pattern from t = 0 against a record that starts later: no
+    wrap-around targets; an inverted record aligns on |correlation|."""
+    from stateye.equalization import _align
+
+    rng = np.random.default_rng(3)
+    sym = rng.integers(0, 4, 900)
+    rec = sym[12:812].astype(float)
+    assert np.array_equal(_align(rec, sym), sym[12:812])
+    assert np.array_equal(_align(-rec, sym), sym[12:812])
+    per = sym[:500]                       # one period, rotated record
+    assert np.array_equal(_align(np.roll(per, 37).astype(float), per),
+                          np.roll(per, 37))
+
+
+def test_inverting_transmitter_is_equalized():
+    w, sym, sps = _isi_pam4(post=0.2)
+    taps, info = ffe_mmse(-w, sps, n_taps=5, symbols=sym)
+    assert info["rms_error_after"] < 0.1 * info["rms_error_before"]
+
+
+def test_lms_converges_to_the_mmse_taps():
+    from stateye.equalization import ffe_lms
+
+    w, sym, sps = _isi_pam4(post=0.2)
+    ref, _ = ffe_mmse(w, sps, symbols=sym)
+    taps, info = ffe_lms(w, sps, symbols=sym, mu=0.1, passes=6)
+    assert np.isclose(np.sum(taps), 1.0)
+    assert np.allclose(taps, ref, atol=0.02)
+    assert info["mse"][-1] < info["mse"][0]
+
+
+def test_tdecq_optimal_is_no_worse_than_its_mmse_start():
+    from stateye.equalization import ffe_tdecq_optimal
+
+    w, sym, sps = _isi_pam4(n=2400, post=0.2)
+    rng = np.random.default_rng(1)
+    w = w + 0.01 * rng.standard_normal(w.size)
+    dt = 1e-12
+    gbps = 1.0 / (dt * sps) / 1e9
+    start, _ = ffe_mmse(w, sps, symbols=sym)
+    _, info0 = ffe_tdecq_optimal(w, dt, gbps, symbols=sym, start_taps=start,
+                                 max_evals=1)
+    taps, info = ffe_tdecq_optimal(w, dt, gbps, symbols=sym, start_taps=start,
+                                   max_evals=12)
+    assert np.isclose(np.sum(taps), 1.0)
+    assert info["tdecq"] <= info0["tdecq"] + 1e-9
+    assert info["violations"] == []
+
+    seen = []
+    taps, info = ffe_tdecq_optimal(w, dt, gbps, symbols=sym, max_evals=12,
+                                   n_dfe=1, progress=lambda *a: seen.append(a))
+    assert np.isclose(np.sum(taps), 1.0) and len(info["dfe_b"]) == 1
+    assert 0.0 <= info["dfe_b"][0] <= 0.3 and info["violations"] == []
+    assert info["tdecq"] <= seen[0][2] + 1e-9           # no worse than start
+    # progress: one callback per evaluation, counting up, best never rising
+    assert [a[0] for a in seen] == list(range(1, len(seen) + 1))
+    assert all(a[1] == 12 for a in seen) and len(seen) >= 12
+    assert all(seen[i][3] >= seen[i + 1][3] for i in range(len(seen) - 1))
+
+
+
+@pytest.mark.parametrize("method", ["mmse", "lms"])
+def test_noise_only_eye_is_not_averaged_away(method):
+    """No ISI, just noise: the max-SNR FFE is (nearly) a pass-through. A
+    design with a floating target span instead low-passes the eye shut
+    (C_eq < 1, smaller opening) to shrink its residual."""
+    from stateye.equalization import ffe_lms
+
+    w, sym, sps = _isi_pam4(post=0.0)
+    w = w + 0.03 * np.random.default_rng(2).standard_normal(w.size)
+    fn = ffe_mmse if method == "mmse" else ffe_lms
+    taps, info = fn(w, sps, symbols=sym)
+    assert info["ceq"] == pytest.approx(1.0, abs=0.05)
+    assert taps[1] > 0.95
+
+
+def _isi_long_tail(n=4000, sps=16, seed=0):
+    """A long post-cursor tail -- what a DFE is for."""
+    rng = np.random.default_rng(seed)
+    sym = rng.integers(0, 4, n)
+    lv = sym / 3.0
+    h = [1.0, 0.3, 0.2, 0.1]
+    isi = sum(hj * np.concatenate([[lv[0]] * j, lv[:n - j]]) for j, hj in enumerate(h))
+    return np.repeat(isi, sps), sym, sps
+
+
+@pytest.mark.parametrize("method", ["mmse", "lms"])
+def test_dfe_cancels_post_cursors_without_noise_enhancement(method):
+    from stateye.equalization import equalize, ffe_lms
+
+    w, sym, sps = _isi_long_tail()
+    w = w + 0.01 * np.random.default_rng(3).standard_normal(w.size)
+    fn = ffe_mmse if method == "mmse" else ffe_lms
+    kw = {"mu": 0.1, "passes": 6} if method == "lms" else {}
+    c0, i0 = fn(w, sps, n_taps=3, n_pre=1, symbols=sym, **kw)
+    c1, i1 = fn(w, sps, n_taps=3, n_pre=1, symbols=sym, n_dfe=3, **kw)
+    assert len(i1["dfe_taps"]) == 3 and all(g > 0 for g in i1["dfe_taps"])
+    # the DFE takes the tail off the FFE: less noise enhancement, less error
+    assert i1["ceq"] < i0["ceq"]
+    assert i1["rms_error_after"] < 0.7 * i0["rms_error_after"]
+    eq = equalize(w, c1, i1, sps)
+    s = eq[int(i1["phase"])::sps][40:-40]
+    d = sym[40:-40]
+    for k in range(3):
+        assert s[d == k].max() < s[d == k + 1].min()
