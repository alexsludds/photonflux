+    # the low-pass "equalizer" an unconstrained TDECQ search found: main tap
+    # 0.885 < 0.9 (C_eq 0.899) -- not a legal reference equalizer
+    bad = [0.089, -0.074, 0.885, -0.010, 0.110]
+    v = tap_limit_violations(bad, n_pre=2)
