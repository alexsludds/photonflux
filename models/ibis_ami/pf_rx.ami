(pf_rx
    (Description "photonflux open-source IBIS-AMI receiver: CTLE (Init-adapted), AGC, UI-spaced FFE and DFE (LMS-adapted in GetWave), bang-bang or Mueller-Muller CDR, NRZ / PAM4 slicer. Dual mode: Init designs the equalizer from the channel and seeds GetWave.")

    (Reserved_Parameters
        (AMI_Version (Usage Info) (Type String) (Value "7.1")
            (Description "IBIS version this model follows."))
        (Init_Returns_Impulse (Usage Info) (Type Boolean) (Value True)
            (Description "Init returns the CTLE/FFE/AGC-equalized impulse with the DFE's zero-forced post-cursors notched out."))
        (GetWave_Exists (Usage Info) (Type Boolean) (Value True)
            (Description "GetWave runs CTLE, FFE, DFE and CDR sample by sample with live adaptation."))
        (Use_Init_Output (Usage Info) (Type Boolean) (Value False)
            (Description "GetWave seeds itself from Init's internal design, not its output impulse."))
        (Max_Init_Aggressors (Usage Info) (Type Integer) (Value 64)
            (Description "Linear equalization is applied to every aggressor row."))
        (Ignore_Bits (Usage Info) (Type Integer) (Value 3000)
            (Description "Symbols to discard while CDR and adaptation converge."))
        (Modulation (Usage In) (Type String) (List "NRZ" "PAM4") (Default "NRZ")
            (Description "Line code: two-level NRZ or Gray-coded PAM4."))
        (Rx_Noise (Usage Info) (Type Float) (Value 0.0)
            (Description "Gaussian noise (V rms) at the sampling latch the EDA tool should add."))
        (Rx_Rj (Usage Info) (Type Float) (Value 0.0)
            (Description "Random jitter (s rms) of the sampling clock for statistical analysis."))
        (Rx_Dj (Usage Info) (Type Float) (Value 0.0)
            (Description "Dual-Dirac deterministic jitter (s pk-pk) of the sampling clock."))
    )
    (Model_Specific
        (ctle
            (ctle_mode (Usage In) (Type Integer) (List 0 1 2) (Default 2)
                (List_Tip "off" "fixed" "adaptive (Init)")
                (Description "CTLE off, fixed at ctle_peaking_db, or chosen by Init from 0..ctle_max_db."))
            (ctle_peaking_db (Usage In) (Type Float) (Range 6.0 0.0 24.0)
                (Description "CTLE peaking (DC attenuation relative to the peaked band) in dB."))
            (ctle_fp1 (Usage In) (Type Float) (Range 10e9 0.5e9 100e9)
                (Description "CTLE first pole (Hz); put it near the Nyquist frequency."))
            (ctle_fp2_mult (Usage In) (Type Float) (Range 2.0 1.0 10.0)
                (Description "Second pole as a multiple of the first."))
            (ctle_max_db (Usage In) (Type Float) (Range 16.0 0.0 24.0)
                (Description "Largest peaking the adaptive CTLE may pick."))
            (ctle_step_db (Usage In) (Type Float) (Range 1.0 0.25 4.0)
                (Description "Adaptive CTLE search step."))
        )
        (agc
            (agc_mode (Usage In) (Type Integer) (List 0 1 2) (Default 1)
                (List_Tip "off" "set by Init" "adaptive")
                (Description "Variable-gain amplifier: unity, set once by Init, or tracked in GetWave."))
            (agc_target (Usage In) (Type Float) (Range 0.2 0.01 1.0)
                (Description "Outer data level (V) the AGC aims for at the slicer."))
            (agc_mu (Usage In) (Type Float) (Range 1e-4 0.0 1e-2)
                (Description "AGC adaptation step."))
        )
        (ffe
            (ffe_mode (Usage In) (Type Integer) (List 0 1 2) (Default 0)
                (List_Tip "off" "MMSE in Init" "MMSE seed + LMS")
                (Description "UI-spaced receive FFE (the optical-DSP equalizer)."))
            (ffe_ntaps (Usage In) (Type Integer) (Range 7 2 31)
                (Description "FFE length in UI."))
            (ffe_pre (Usage In) (Type Integer) (Range 1 0 15)
                (Description "Pre-cursor taps (main tap index)."))
            (ffe_mu (Usage In) (Type Float) (Range 2e-3 0.0 0.1)
                (Description "Normalized-LMS step for the FFE. The main tap is fixed (the AGC owns gain) and, under an adaptive CDR, so is the first pre-cursor tap (the CDR owns timing)."))
        )
        (dfe
            (dfe_mode (Usage In) (Type Integer) (List 0 1 2) (Default 2)
                (List_Tip "off" "zero-forced in Init" "zero-forced seed + LMS")
                (Description "Decision-feedback equalizer."))
            (dfe_ntaps (Usage In) (Type Integer) (Range 5 0 16)
                (Description "DFE taps (post-cursors cancelled)."))
            (dfe_mu (Usage In) (Type Float) (Range 2e-3 0.0 0.1)
                (Description "LMS step for the DFE taps."))
            (dfe_tap_max (Usage In) (Type Float) (Range 0.6 0.05 1.0)
                (Description "Tap limit, relative to the outer data level."))
        )
        (cdr
            (cdr_mode (Usage In) (Type Integer) (List 0 1 2) (Default 1)
                (List_Tip "fixed phase" "bang-bang" "Mueller-Muller")
                (Description "Clock recovery: Init's phase, Alexander bang-bang, or baud-rate Mueller-Muller."))
            (cdr_kp (Usage In) (Type Float) (Range 4e-3 0.0 0.1)
                (Description "Proportional gain (UI per phase-detector unit)."))
            (cdr_ki (Usage In) (Type Float) (Range 4e-6 0.0 1e-3)
                (Description "Integral gain (UI per UI per phase-detector unit; tracks frequency offset)."))
            (cdr_init_phase (Usage In) (Type Float) (Range 0.5 0.0 1.0)
                (Description "Starting sampling phase (UI) if Init found no main cursor."))
            (cdr_calibrate (Usage In) (Type Boolean) (Value True)
                (Description "Init calibrates the bang-bang CDR's phase offset: from the equalized pulse it finds where the loop will lock (crossing midpoints) and the best data phase, and samples data that far from the lock point."))
            (cdr_offset_ui (Usage In) (Type Float) (Range 0.0 -0.5 0.5)
                (Description "Extra data-sampling offset from the bang-bang lock point (UI), added to the calibrated one."))
        )
        (level_mu (Usage In) (Type Float) (Range 1e-3 0.0 0.05)
            (Description "Data-level (slicer reference) tracking step."))
        (rx_noise_nv (Usage In) (Type Float) (Range 5.0 0.0 100.0)
            (Description "Input-referred noise density (nV/rtHz) the Init equalizer design trades against ISI."))
    )
)
