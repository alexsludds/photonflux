      "WG_R2.length_m": "ring_um*0.5e-6",
      "DC1.coupling": "k1",
      "DC2.coupling": "k2",
      "PRBS.v0": "vbias - v_emf_pp/2",
      "PRBS.v1": "vbias + v_emf_pp/2",
      "RDA.R": "r_drv_ohm",
      "RDB.R": "r_drv_ohm",
      "RTA.R": "r_term_ohm",
      "RTB.R": "r_term_ohm",
      "VTERM.V": "vbias",
      "PN_A.rs_ohm_mm": "rs_ohm_mm",
      "PN_A.z0_ohm": "z0_ohm",
      "PN_A.n_rf": "n_rf",
      "PN_A.rf_loss_dB_cm": "rf_loss_db_cm",
      "PN_B.rs_ohm_mm": "rs_ohm_mm",
      "PN_B.z0_ohm": "z0_ohm",
      "PN_B.n_rf": "n_rf",
      "PN_B.rf_loss_dB_cm": "rf_loss_db_cm",
      "PRBS.ffe_pre": "ffe_pre",
      "PRBS.ffe_post": "ffe_post",
      "VRAIL.V": "2*vbias"
    },
    "stateye": {
