        "at": "PD1,cat",
        "color": "#6ecbf5"
      }
    ]
  },
  "analysis": {
    "mode": "transient",
    "t_stop": 1.28e-08,
    "points": 8000,
    "link": {
      "probe": "vout",
      "ffe_taps": 5,
      "dfe_taps": 1
    }
  }
}