    "steps": [
      {
        "id": "res",
        "kind": "analysis",
        "title": "Find resonance at the bias",
        "set": {
          "PRBS.v0": "vbias",
          "PRBS.v1": "vbias"
        },
        "analysis": {
          "mode": "dcsweep",
          "instance": "*",
          "param": "wavelength_nm",
          "start": 1309.5,
          "stop": 1310.5,
          "points": 1001,
          "warm_start": true
        },
        "outputs": {
          "lam_res": "xat_min(thru)",
          "notch_db": "dbp(min(thru)/max(thru))"
        },
        "checks": [
          "notch_db < -1"
        ]
      },
      {
        "id": "eye",
        "kind": "analysis",
        "title": "PAM4 eye at the lock point",
        "set": {
          "*.wavelength_nm": "lam_res - detune_pm*1e-3"
        },
        "analysis": {
          "mode": "transient",
          "t_stop": 9.411764705882354e-09,
          "points": 10000
        },
        "outputs": {
          "rlm": "rlm(thru)",
          "er_db": "er_db(thru)",
          "rel_oma_db": "rel_oma_db(thru, mod_in)",
          "il_db": "il_db(thru, mod_in)",
          "tdecq_db": "tdecq(thru)"
        },
        "checks": []
      },
      {
        "id": "opt",
        "kind": "optimize",
        "title": "Maximize the worst spec margin (incl. TX FFE, DC1, termination)",
        "inner": [
          "res",
          "eye"
        ],
        "params": [
          {
            "var": "detune_pm",
            "min": 0.5,
            "max": 15.0
          },
          {
            "var": "vbias",
            "min": 1.0,
            "max": 2.6
          },
          {
            "var": "dL_nm",
            "min": 150.0,
            "max": 450.0
          },
          {
            "var": "pn_um",
            "min": 200.0,
            "max": 800.0
          },
          {
            "var": "r_term_ohm",
            "min": 20.0,
            "max": 80.0
          },
          {
            "var": "k1",
            "min": 0.15,
            "max": 0.85
          },
          {
            "var": "ffe_pre",
            "min": -0.3,
            "max": 0.3
          },
          {
            "var": "ffe_post",
            "min": -0.5,
            "max": 0.5
          }
        ],
        "objective": "min((rlm - 0.95)/0.05, (1.5 - tdecq_db)/1.5, (rel_oma_db + 2)/2, (er_db - 3.5)/3.5)",
        "maximize": true,
        "constraints": [],
        "method": "bayes",
        "iters": 60
      },
      {
        "id": "eval",
        "kind": "evaluate",
        "title": "Evaluate the best design",
        "inner": [
          "res",
          "eye"
        ],
        "record": "full_period",
        "probes": {
          "in": "mod_in",
          "out": "thru"
        },
        "fom": {
          "rel_oma_db": ">= -2",
          "oma_dbm": null,
          "il_db": null,
          "er_db": ">= 3.5",
          "tdecq_db": "<= 1.5",
          "rlm": ">= 0.95"
        }
      }
    ]
  }
