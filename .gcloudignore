# What `gcloud builds submit` uploads as the build context. Mirror .gitignore so
# the 706 MB Mac venv and other local-only cruft never get uploaded (~27 MB left).
# NOTE: presence of this file disables gcloud's default .gitignore fallback, so
# keep it in sync with .gitignore.
.git/
.gitignore
.venv-circulax/
out/
bin/openvaf-r
bin/openvaf-ir
models/*.osdi
models/__jax__/*.osdi
webapp/uploads/
webapp/models_user/
**/__pycache__/
*.pyc
*.pyo
.DS_Store
.vscode/
.idea/
*.swp
