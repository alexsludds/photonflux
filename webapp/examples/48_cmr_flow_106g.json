      "ffe_taps": 0,
      "dfe_taps": 0
    }
  },
  "flow": {
    "name": "Resonance → PAM4 eye → optimize → evaluate",
    "vars": {
      "detune_pm": 2.0,
      "dL_nm": 250.0,
      "vbias": 2.0,
      "pn_um": 250.0,
      "ring_um": 150.0,
      "vswing": 2.0,
      "r_drv_ohm": 50.0,
      "rs_ohm_mm": 10.0,
      "vpil_vcm": 2.0,
      "loss_db_cm": 12.0,
      "cj0_ff_um": 0.3
    },
    "set": {
      "WG_A.length_m": "2.0120095e-05 + dL_nm*0.5e-9",
      "WG_B.length_m": "2.0120095e-05 - dL_nm*0.5e-9",
      "PRBS.v0": "vbias - vswing/2",
      "PRBS.v1": "vbias + vswing/2",
      "PN_A.length_m": "pn_um*1e-6",
      "PN_B.length_m": "pn_um*1e-6",
      "PN_A.vpil_vcm": "vpil_vcm",
      "PN_B.vpil_vcm": "vpil_vcm",
      "PN_A.loss_dB_cm": "loss_db_cm",
      "PN_B.loss_dB_cm": "loss_db_cm",
      "PN_A.cj0_ff_um": "cj0_ff_um",
      "PN_B.cj0_ff_um": "cj0_ff_um",
      "WG_R1.length_m": "ring_um*0.5e-6",
      "WG_R2.length_m": "ring_um*0.5e-6",
      "RDRV.R": "r_drv_ohm + rs_ohm_mm/(pn_um*1e-3)/2"
    },
    "stateye": {
      "rx_bw": "auto",
      "rx_order": 4,
      "taps": 5,
      "pre": 1,
      "dfe": 0,
      "method": "mmse",
      "limits": true,
      "use_pattern": true,
      "s_noise": 0.005,
      "ser": 0.00048,
      "nx": 256,
      "ny": 1024
    },
    "steps": [
      {
        "id": "res",
        "kind": "analysis",
        "title": "Find resonance at the bias",
        "set": {
          "PRBS.v0": "vbias",
          "PRBS.v1": "vbias"
        },
        "analysis": {
          "mode": "dcsweep",
          "instance": "*",
          "param": "wavelength_nm",
          "start": 1309.5,
          "stop": 1310.5,
          "points": 2001
        },
        "outputs": {
          "lam_res": "xat_min(thru)",
          "notch_db": "dbp(min(thru)/max(thru))"
        },
        "checks": [
          "notch_db < -3"
        ]
      },
      {
        "id": "eye",
        "kind": "analysis",
        "title": "PAM4 eye at the lock point",
        "set": {
          "*.wavelength_nm": "lam_res - detune_pm*1e-3"
        },
        "analysis": {
          "mode": "transient",
          "t_stop": 9.411764705882354e-09,
          "points": 10000
        },
        "outputs": {
          "rlm": "rlm(thru)",
          "er_db": "er_db(thru)",
          "rel_oma_db": "rel_oma_db(thru, mod_in)",
          "il_db": "il_db(thru, mod_in)",
          "tdecq_db": "tdecq(thru)"
        },
        "checks": []
      },
      {
        "id": "opt",
        "kind": "optimize",
        "title": "Maximize the worst spec margin",
        "inner": [
          "res",
          "eye"
        ],
        "params": [
          {
            "var": "detune_pm",
            "min": 0.5,
            "max": 8.0
          },
          {
            "var": "vbias",
            "min": 1.4,
            "max": 2.6
          },
          {
            "var": "dL_nm",
            "min": 150.0,
            "max": 450.0
          },
          {
            "var": "pn_um",
            "min": 100.0,
            "max": 600.0
          },
          {
            "var": "ring_um",
            "min": 100.0,
            "max": 800.0
          }
        ],
        "objective": "min((rlm - 0.95)/0.05, (1.5 - tdecq_db)/1.5, (rel_oma_db + 2)/2, (er_db - 3.5)/3.5)",
        "maximize": true,
        "constraints": [],
        "iters": 50
      },
      {
        "id": "eval",
        "kind": "evaluate",
        "title": "Evaluate the best design",
        "inner": [
          "res",
          "eye"
        ],
        "record": "full_period",
        "probes": {
          "in": "mod_in",
          "out": "thru"
        },
        "fom": {
          "rel_oma_db": ">= -2",
          "oma_dbm": null,
          "il_db": null,
          "er_db": ">= 3.5",
          "tdecq_db": "<= 1.5",
          "rlm": ">= 0.95"
        }
      }
    ]
  }
}
