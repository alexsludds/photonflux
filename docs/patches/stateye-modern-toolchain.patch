+@pytest.mark.parametrize("method", ["mmse", "lms"])
+def test_noise_only_eye_is_not_averaged_away(method):
+    """No ISI, just noise: the max-SNR FFE is (nearly) a pass-through. A
+    design with a floating target span instead low-passes the eye shut
+    (C_eq < 1, smaller opening) to shrink its residual."""
+    from stateye.equalization import ffe_lms
+
+    w, sym, sps = _isi_pam4(post=0.0)
+    w = w + 0.03 * np.random.default_rng(2).standard_normal(w.size)
+    fn = ffe_mmse if method == "mmse" else ffe_lms
+    taps, info = fn(w, sps, symbols=sym)
+    assert info["ceq"] == pytest.approx(1.0, abs=0.05)
+    assert taps[1] > 0.95
