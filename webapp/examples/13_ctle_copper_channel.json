{
  "title": "CTLE copper channel",
  "group": "Channels & equalization",
  "description": "10 Gb/s over a lossy copper channel, equalized by a CTLE",
  "schematic": {
    "notes": [
      {
        "x": 100,
        "y": -23,
        "title": "CTLE copper channel \u2014 what this testbench does",
        "lines": [
          "PAT1 drives a 10 Gb/s NRZ PRBS (ui=100ps) into CH1,",
          "a lossy copper channel (12 dB loss at 5 GHz Nyquist).",
          "EQ1 (a CTLE) then feeds RT1 (1 Mohm termination).",
          "",
          "The channel's high-frequency roll-off smears bits",
          "together (ISI), closing the eye at vch. EQ1 boosts",
          "9 dB of peaking near Nyquist to reopen it at vout.",
          "Set EQ1.peaking_db = 0 and re-run to switch off the",
          "CTLE and watch the eye collapse."
        ]
      }
    ],
    "instances": {
      "PAT1": {
        "type": "prbs",
        "x": 100,
        "y": 290,
        "rot": 0,
        "settings": {
          "ui": 1e-10,
          "order": 9,
          "v0": -0.5,
          "v1": 0.5,
          "tr": 2.5e-11
        }
      },
      "GNDP": {
        "type": "ground",
        "x": 100,
        "y": 394,
        "rot": 0,
        "settings": {}
      },
      "CH1": {
        "type": "channel",
        "x": 240,
        "y": 180,
        "rot": 0,
        "settings": {
          "loss_db": 12.0,
          "f_nyq": 5000000000.0,
          "n_poles": 10
        }
      },
      "EQ1": {
        "type": "ctle",
        "x": 420,
        "y": 175,
        "rot": 0,
        "settings": {
          "peaking_db": 9.0,
          "f_p1": 5000000000.0,
          "fp2_mult": 2.0
        }
      },
      "GNDE": {
        "type": "ground",
        "x": 640,
        "y": 244,
        "rot": 0,
        "settings": {}
      },
      "RT1": {
        "type": "resistor",
        "x": 600,
        "y": 190,
        "rot": 0,
        "settings": {
          "R": 1000000.0
        }
      }
    },
    "wires": [
      {
        "from": "PAT1,p1",
        "to": "CH1,inp"
      },
      {
        "from": "PAT1,p2",
        "to": "GNDP,p1"
      },
      {
        "from": "CH1,out",
        "to": "EQ1,inp"
      },
      {
        "from": "EQ1,out",
        "to": "RT1,p1"
      },
      {
        "from": "RT1,p2",
        "to": "GNDE,p1"
      }
    ],
    "probes": [
      {
        "name": "vch",
        "at": "CH1,out",
        "color": "#e6862c"
      },
      {
        "name": "vout",
        "at": "EQ1,out",
        "color": "#6ecbf5"
      }
    ]
  },
  "analysis": {
    "mode": "transient",
    "t_stop": 5.12e-08,
    "points": 8000,
    "link": {
      "probe": "vout"
    }
  }
}
