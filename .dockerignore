# Keep the build context small and free of Mac-native artifacts. The image
# rebuilds every native piece for Linux (openvaf-ir from source, .osdi via
# warmup) and installs Python deps from wheels — none of the local venv or
# vendored Mac binaries should enter the image.
.venv-circulax/
.git/
.gitignore
out/
**/__pycache__/
*.pyc
*.pyo

# Mac-native binary — replaced by the Linux build inside the image
bin/openvaf-ir

# Compiled device models + JAX cache — regenerated for Linux during warmup
models/*.osdi
models/*.osdi.meta.json
models/__jax__/

# Local/user runtime state that must not ship in a public image
webapp/uploads/
webapp/models_user/

# Editor/OS noise
.DS_Store
.vscode/
.idea/
*.swp
