{
  "title": "Photodiode + TIA receiver",
  "group": "Links & receivers",
  "schematic": {
    "notes": [
      {
        "x": 40,
        "y": -78,
        "title": "Photodiode + TIA receiver — what this testbench does",
        "lines": [
          "CW laser LAS1 (1310 nm) is on/off-keyed by pulse mod MOD1,",
          "sent down waveguide FIB1, and caught by photodiode PD1.",
          "PD1 turns optical power into a current; TIA1 is a dedicated",
          "transimpedance amp whose inp is a virtual ground summing node:",
          "vout ~= -Iph * TIA1.gain_ohm. Probe popt_rx shows the received",
          "optical pulse; probe vout shows the recovered voltage.",
          "",
          "Set TIA1.gain_ohm = 1000 and re-run to see the vout swing grow ~5x",
          "(gain scales with the transimpedance)."
        ]
      }
    ],
    "instances": {
      "LAS1": {
        "type": "cw_laser",
        "x": 40,
        "y": 180,
        "rot": 0,
        "settings": {
          "wavelength_nm": 1310.0,
          "power": 0.018
        }
      },
      "MOD1": {
        "type": "pulse_mod",
        "x": 240,
        "y": 180,
        "rot": 0,
        "settings": {
          "p_on": 0.018,
          "p_off": 0.003
        }
      },
      "FIB1": {
        "type": "waveguide",
        "x": 380,
        "y": 190,
        "rot": 0,
        "settings": {
          "length_m": 0.0015,
          "loss_dB_cm": 20.0
        }
      },
      "PD1": {
        "type": "photodiode",
        "x": 500,
        "y": 180,
        "rot": 0,
        "settings": {}
      },
      "TIA1": {
        "type": "tia",
        "x": 620,
        "y": 180,
        "rot": 0,
        "settings": {
          "gain_ohm": 200.0
        }
      },
      "GND1": {
        "type": "ground",
        "x": 60,
        "y": 264,
        "rot": 0,
        "settings": {}
      },
      "GND2": {
        "type": "ground",
        "x": 510,
        "y": 290,
        "rot": 0,
        "settings": {}
      }
    },
    "wires": [
      {
        "from": "LAS1,p1",
        "to": "MOD1,pin"
      },
      {
        "from": "MOD1,pout",
        "to": "FIB1,p1"
      },
      {
        "from": "FIB1,p2",
        "to": "PD1,po_p"
      },
      {
        "from": "PD1,cat",
        "to": "TIA1,inp"
      },
      {
        "from": "LAS1,p2",
        "to": "GND1,p1"
      },
      {
        "from": "PD1,po_n",
        "to": "GND2,p1"
      },
      {
        "from": "PD1,an",
        "to": "GND2,p1"
      }
    ],
    "probes": [
      {
        "name": "popt_rx",
        "at": "PD1,po_p",
        "color": "#fbbf24"
      },
      {
        "name": "vout",
        "at": "TIA1,out",
        "color": "#6ecbf5"
      }
    ]
  },
  "analysis": {
    "mode": "transient",
    "t_stop": 4e-09,
    "points": 800
  }
}
